// Life Planner database schema (PostgreSQL)
//
// Dates that are "calendar days" (a task's start/due date, an activity's day,
// a journal day) are stored as "YYYY-MM-DD" strings and times of day as
// "HH:mm" strings. They are interpreted in the user's timezone (UserSettings).
// This avoids timezone shifts when a day is read on another device.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core tables (user, session, account, verification)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  settings       UserSettings?
  categories     Category[]
  tasks          Task[]
  activities     Activity[]
  habits         Habit[]
  habitLogs      HabitLog[]
  goals          Goal[]
  journalEntries JournalEntry[]
  attachments    Attachment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Planner
// ---------------------------------------------------------------------------

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
}

enum Mood {
  HAPPY
  PRODUCTIVE
  NORMAL
  TIRED
  STRESSED
  SAD
}

enum AttachmentKind {
  TASK
  DECOR
}

model UserSettings {
  userId        String    @id
  displayName   String?
  timezone      String    @default("Asia/Bangkok")
  dateFormat    String    @default("D MMM YYYY")
  weekStartsOn  Int       @default(1) // 1 = Monday, 0 = Sunday
  theme         String    @default("ivory")
  accent        String    @default("sage")
  font          String    @default("journal")
  calendarView  String    @default("month")
  showCompleted Boolean   @default(true)
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id         String     @id @default(cuid())
  userId     String
  name       String
  color      String
  position   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  activities Activity[]

  @@unique([userId, name])
  @@index([userId, position])
}

model Task {
  id               String       @id @default(cuid())
  userId           String
  title            String
  description      String?
  categoryId       String?
  priority         Priority     @default(MEDIUM)
  status           TaskStatus   @default(NOT_STARTED)
  startDate        String? // YYYY-MM-DD — the day the task is planned for
  dueDate          String? // YYYY-MM-DD — deadline
  startTime        String? // HH:mm
  endTime          String? // HH:mm
  estimatedMinutes Int?
  actualMinutes    Int?
  notes            String?
  reminderMinutes  Int? // minutes before the start time (null = no reminder)
  repeat           Repeat       @default(NONE)
  repeatAnchor     String? // YYYY-MM-DD — first day of a repeating series
  seriesId         String? // shared by every occurrence of a repeating task
  nextSpawnedAt    DateTime? // set once the next occurrence has been created
  goalId           String?
  completedAt      DateTime?
  deletedAt        DateTime? // soft delete (Trash)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal             Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  subtasks         Subtask[]
  attachments      Attachment[]

  @@index([userId, startDate])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([seriesId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Attachment {
  id        String         @id @default(cuid())
  userId    String
  taskId    String?
  kind      AttachmentKind @default(TASK)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([taskId])
}

model Activity {
  id         String    @id @default(cuid())
  userId     String
  title      String
  date       String // YYYY-MM-DD
  startTime  String // HH:mm
  endTime    String? // HH:mm
  categoryId String?
  notes      String?
  important  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  name      String
  position  Int        @default(0)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String // YYYY-MM-DD
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  month       String // YYYY-MM
  status      GoalStatus @default(ACTIVE)
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId, month])
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  date         String // YYYY-MM-DD
  happened     String? // Quick Journal: What happened today?
  feeling      String? // Quick Journal: How do I feel today?
  learned      String? // Shared: What did I learn today?
  proud        String? // Quick Journal: What am I proud of?
  improve      String? // Shared: What could I improve?
  accomplished String? // Reflection: What did I accomplish today?
  wentWell     String? // Reflection: What went well?
  mood         Mood? // Reflection: How was my mood today?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
